{
  "name": "Post",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "tags": {
      "type": "string"
    },
    "emoji": {
      "type": "string"
    },
    "bg_class": {
      "type": "string"
    },
    "filter": {
      "type": "string",
      "default": "none"
    },
    "music": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "friends",
        "private"
      ],
      "default": "public"
    },
    "is_adult": {
      "type": "boolean",
      "default": false
    },
    "allow_comments": {
      "type": "boolean",
      "default": true
    },
    "allow_downloads": {
      "type": "boolean",
      "default": true
    },
    "likes_count": {
      "type": "number",
      "default": 0
    },
    "reloops_count": {
      "type": "number",
      "default": 0
    },
    "comments_count": {
      "type": "number",
      "default": 0
    },
    "views_count": {
      "type": "number",
      "default": 0
    },
    "is_draft": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "username"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.visibility": "public"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}",
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "created_by_id": "{{user.id}}",
      "user_condition": {
        "role": "admin"
      }
    }
  }
}