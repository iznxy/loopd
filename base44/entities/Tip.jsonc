{
  "name": "Tip",
  "type": "object",
  "properties": {
    "from_user_id": {
      "type": "string"
    },
    "from_username": {
      "type": "string"
    },
    "to_user_id": {
      "type": "string"
    },
    "to_username": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "label": {
      "type": "string"
    }
  },
  "required": [
    "from_user_id",
    "to_user_id",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.from_user_id": "{{user.id}}"
        },
        {
          "data.to_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}