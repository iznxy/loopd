{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_username": {
      "type": "string"
    },
    "receiver_id": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "voice",
        "gif"
      ],
      "default": "text"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "conversation_id",
    "sender_id",
    "receiver_id"
  ]
}