{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_username": {
      "type": "string"
    },
    "receiver_id": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "audio_url": {
      "type": "string",
      "description": "Legacy: stored signed URL. Expires; new voice notes use audio_file_uri instead."
    },
    "audio_file_uri": {
      "type": "string",
      "description": "Private file reference for voice notes. Signed on read, never stored as a URL."
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "voice",
        "gif"
      ],
      "default": "text"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "conversation_id",
    "sender_id",
    "receiver_id"
  ],
  "rls": {
    "create": {
      "data.sender_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.receiver_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.receiver_id": "{{user.id}}"
        }
      ]
    }
  }
}