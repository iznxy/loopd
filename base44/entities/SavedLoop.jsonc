{
  "name": "SavedLoop",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "post_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "post_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}",
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "data.user_id": "{{user.id}}",
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "data.user_id": "{{user.id}}",
      "user_condition": {
        "role": "admin"
      }
    }
  }
}